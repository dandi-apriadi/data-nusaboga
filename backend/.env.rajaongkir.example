# RajaOngkir API Configuration
# Daftar gratis di: https://rajaongkir.com/
RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here
RAJAONGKIR_ORIGIN_CITY=39

# Origin City IDs (contoh):
# 39 = Bandung
# 152 = Jakarta
# 153 = Jakarta Barat
# 154 = Jakarta Pusat
# 155 = Jakarta Selatan
# 156 = Jakarta Timur
# 157 = Jakarta Utara
# 
# Untuk mencari city_id lainnya, akses:
# GET http://localhost:5001/api/v1/shipping/cities
